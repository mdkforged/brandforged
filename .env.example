# Public Supabase (required for auth UI and browser/server clients)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only admin client (optional; never expose to the browser)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# When true, middleware protects /app, /settings, /workspaces ("/" stays public)
AUTH_REQUIRED=false
